[Unit]
Description=BASR agent service
Documentation=https://github.com/4t145/basr
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/basrd
Restart=on-failure
RestartSec=2s
# The daemon pings the service manager at half this interval.
WatchdogSec=30s

# Everything is configured through the environment, so the unit needs no
# writable configuration directory.
Environment=BASRD_LISTEN=127.0.0.1:7337
Environment=BASRD_AGENTS=embedded
Environment=BASRD_LOG_BACKEND=journald
Environment=BASRD_NOTIFY=auto

# The service reads and writes files on the user's behalf and can spawn agents,
# so it must not run as root unless the operator really wants that.
User=basr
Group=basr
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h

[Install]
WantedBy=default.target
