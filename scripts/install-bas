#!/usr/bin/env bash
set -euo pipefail

service=false
for argument in "$@"; do
    case "$argument" in
        --with-codex|--with-codex=*)
            echo '--with-codex is no longer supported: Bas installs only Bas. Install ACP adapters independently; see docs/install.md (Codex and migration). Existing packages and configuration are unchanged.' >&2
            exit 2 ;;
    esac
done
while [[ $# -gt 0 ]]; do
    case "$1" in
        --service) service=true; shift ;;
        -h|--help)
            cat <<'USAGE'
Usage: scripts/install-bas [--service] [nix profile add options...]
Install bas and bast into your Nix profile.
  --service     Link and enable the systemd user service, starting it immediately.
ACP adapters and their CLIs are installed and managed independently by you.
No user configuration is created or changed. See docs/install.md.
bas also works as a foreground command.
USAGE
            exit 0 ;;
        *) break ;;
    esac
done

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v nix >/dev/null || { echo 'Nix with flakes enabled is required.' >&2; exit 1; }
[[ $(uname -s) = Linux ]] || { echo 'The bas package currently requires Linux.' >&2; exit 1; }
source_path=$("$root/scripts/nix-source")
package_path=$(nix eval --raw "$source_path#bas.outPath")

"$root/scripts/nix-profile-install" "$source_path" bas -- "$@"

if $service; then
    systemctl --user link --force "$package_path/share/systemd/user/bas.service"
    systemctl --user daemon-reload
    systemctl --user enable --force bas.service
    # Restart so a running daemon picks up the freshly installed binary.
    systemctl --user restart bas.service
fi
echo 'Installed bas and bast. Run bas, or manage the service with systemctl --user.'
