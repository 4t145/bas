#!/usr/bin/env bash
set -euo pipefail

service=false
for argument in "$@"; do
    case "$argument" in
        --with-codex|--with-codex=*)
            echo '--with-codex is no longer supported: BASR installs only BASR. Install ACP adapters independently; see docs/install.md (Codex and migration). Existing packages and configuration are unchanged.' >&2
            exit 2 ;;
    esac
done
while [[ $# -gt 0 ]]; do
    case "$1" in
        --service) service=true; shift ;;
        -h|--help)
            cat <<'USAGE'
Usage: scripts/install-basrd [--service] [nix profile install options...]
Install basrd and basrctl into your Nix profile.
  --service     Link and enable the systemd user service, starting it immediately.
ACP adapters and their CLIs are installed and managed independently by you.
No user configuration is created or changed. See docs/install.md.
basrd also works as a foreground command.
USAGE
            exit 0 ;;
        *) break ;;
    esac
done

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v nix >/dev/null || { echo 'Nix with flakes enabled is required.' >&2; exit 1; }
[[ $(uname -s) = Linux ]] || { echo 'The basrd package currently requires Linux.' >&2; exit 1; }
source_path=$("$root/scripts/nix-source")
package_path=$(nix eval --raw "$source_path#basrd.outPath")

"$root/scripts/nix-profile-install" "$source_path" basrd -- "$@"

if $service; then
    systemctl --user link "$package_path/share/systemd/user/basrd.service"
    systemctl --user daemon-reload
    systemctl --user enable basrd.service
    # Restart so a running daemon picks up the freshly installed binary.
    systemctl --user restart basrd.service
fi
echo 'Installed basrd and basrctl. Run basrd, or manage the service with systemctl --user.'
