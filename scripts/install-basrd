#!/usr/bin/env bash
set -euo pipefail

service=false
codex=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --service) service=true; shift ;;
        --with-codex) codex=true; shift ;;
        -h|--help)
            cat <<'USAGE'
Usage: scripts/install-basrd [--with-codex] [--service] [nix profile install options...]
Install basrd and basrctl into your Nix profile.
  --with-codex  Install the pinned Codex ACP adapter and create settings.json for a new setup.
  --service     Link and enable the systemd user service, starting it immediately.
Settings: $XDG_CONFIG_HOME/basr/settings.json (default: ~/.config/basr/settings.json).
Existing configuration is preserved. basrd also works as a foreground command.
USAGE
            exit 0 ;;
        *) break ;;
    esac
done

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v nix >/dev/null || { echo 'Nix with flakes enabled is required.' >&2; exit 1; }
[[ $(uname -s) = Linux ]] || { echo 'The basrd package currently requires Linux.' >&2; exit 1; }
source_path=$("$root/scripts/nix-source")
package_path=$(nix eval --raw "$source_path#basrd.outPath")

# Snapshots have different URLs even when their package outputs are identical.
# Keep repeat installations from accumulating duplicate profile entries.
profile_args=()
options=("$@")
for ((i = 0; i < ${#options[@]}; i++)); do
    case "${options[i]}" in
        --profile)
            [[ $((i + 1)) -lt ${#options[@]} ]] || { echo '--profile requires a path.' >&2; exit 1; }
            profile_args=(--profile "${options[i + 1]}")
            ((i += 1)) ;;
        --profile=*) profile_args=(--profile "${options[i]#--profile=}") ;;
    esac
done
installed=$(nix profile list "${profile_args[@]}" --json 2>/dev/null || true)
attributes=(basrd)
if $codex; then attributes+=(codex-acp); fi
packages=()
for attribute in "${attributes[@]}"; do
    output=$(nix eval --raw "$source_path#$attribute.outPath")
    if [[ $installed != *\""$output"\"* ]]; then
        packages+=("$source_path#$attribute")
    fi
done
if [[ ${#packages[@]} -gt 0 ]]; then
    nix profile install "${packages[@]}" "$@"
fi

if $codex; then
    config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
    if [[ $config_dir != /* ]]; then config_dir=$HOME/.config; fi
    config_dir+=/basr
    if [[ ! -e "$config_dir/settings.json" && ! -L "$config_dir/settings.json" ]]; then
        if [[ -e "$config_dir/agents.json" || -L "$config_dir/agents.json" ||
              -e "$config_dir/appearance.json" || -L "$config_dir/appearance.json" ]]; then
            echo 'Existing legacy configuration is preserved; save from BASR settings to migrate it.'
        else
            mkdir -p "$config_dir"
            install -m600 "$package_path/share/basr/settings.example.json" "$config_dir/settings.json"
        fi
    fi
fi
if $service; then
    systemctl --user link "$package_path/share/systemd/user/basrd.service"
    systemctl --user daemon-reload
    systemctl --user enable --now basrd.service
fi
echo 'Installed basrd and basrctl. Run basrd, or manage the service with systemctl --user.'
