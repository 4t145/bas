#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} = -h || ${1:-} = --help ]]; then
    cat <<'USAGE'
Usage: scripts/install-basrw [nix profile install options...]
Build and install basrw into your Nix profile, including its desktop entry and
runtime graphics libraries. basrd is a separate service.
Includes untracked source files; excludes .env files and build outputs.
USAGE
    exit 0
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v nix >/dev/null || { echo 'Nix with flakes enabled is required.' >&2; exit 1; }
[[ $(uname -s) = Linux ]] || { echo 'The basrw package currently requires Linux.' >&2; exit 1; }

source_path=$("$root/scripts/nix-source")
exec nix profile install "$source_path#basrw" "$@"
