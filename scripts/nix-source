#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export BAS_PACKAGE_SOURCE="$root"
# Include untracked source without copying environment files or build outputs.
exec nix eval --impure --raw --expr '
  builtins.path {
    path = builtins.getEnv "BAS_PACKAGE_SOURCE";
    name = "bas-source";
    filter = path: type:
      let name = builtins.baseNameOf path; in
      !(builtins.elem name [ ".git" ".delta" ".direnv" "target" "result" "node_modules" "__pycache__" ])
      && builtins.match "[.]env([.].*)?" name == null;
  }
'
