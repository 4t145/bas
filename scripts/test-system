#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: scripts/test-system [check|build|shell|driver] [nix build options...]
  check  Build Bas, run its Rust tests, boot QEMU, and run system tests (default).
  build  Build the VM test driver without booting a VM.
  shell  Boot the VM, start bas, and enter the guest's root shell.
  driver Open the Python test-driver console for automated test development.
Results and interactive logs are stored under .test-results/.
USAGE
}

mode=${1:-check}
if [ "$#" -gt 0 ]; then shift; fi
case "$mode" in
    check|build|shell|driver) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
if [[ "$mode" = shell || "$mode" = driver ]] && [[ ! -t 0 || ! -t 1 ]]; then
    echo "$mode requires an interactive terminal; use check for automated tests." >&2
    exit 1
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v nix >/dev/null || { echo 'Nix with flakes enabled is required.' >&2; exit 1; }
if [ "$(uname -s)" != Linux ]; then
    echo 'System tests currently require a Linux host or Linux Nix builder.' >&2
    exit 1
fi

export BAS_TEST_SOURCE="$root"
# Snapshot includes untracked source files, excluding credentials and build outputs.
# This also avoids changing the user's Git index just to evaluate a flake.
source_path=$(nix eval --impure --raw --expr '
  builtins.path {
    path = builtins.getEnv "BAS_TEST_SOURCE";
    name = "bas-system-test-source";
    filter = path: type:
      let name = builtins.baseNameOf path; in
      !(builtins.elem name [ ".git" ".delta" ".direnv" "target" ".test-results" "result" ])
      && builtins.match "[.]env([.].*)?" name == null;
  }
')
system=$(nix eval --impure --raw --expr builtins.currentSystem)
results="$root/.test-results"
mkdir -p "$results"

if [ "$mode" = check ]; then
    nix build -L --keep-failed --out-link "$results/system" \
        "$source_path#checks.$system.system" "$@"
    echo "System test artifacts: $results/system/"
else
    entry=driver
    if [ "$mode" = shell ]; then entry=shell; fi
    nix build -L --out-link "$results/$entry" \
        "$source_path#packages.$system.system-test-$entry" "$@"
    if [ "$mode" != build ]; then
        workdir=$(mktemp -d "$results/$mode.XXXXXX")
        echo "VM logs: $workdir"
        cd "$workdir"
        # The driver otherwise shares XDG_RUNTIME_DIR/vm-state-machine between
        # invocations. A short private path also fits Unix socket path limits.
        runtime_dir=$(mktemp -d /tmp/bas-vm.XXXXXX)
        trap 'rm -rf -- "$runtime_dir"' EXIT
        env XDG_RUNTIME_DIR="$runtime_dir" \
            "$results/$entry/bin/nixos-test-driver" --output_directory "$workdir" \
            --junit-xml "$workdir/driver.xml"
    fi
fi
